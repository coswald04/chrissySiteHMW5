---
layout: layouts/base.njk
title: Contact
description: Contact Christine Oswald through her portfolio contact form.
permalink: /contact/
---
<h1 id="contact-header">Contact Info</h1>

<section>
    <h2>Contact Me!</h2>

    <form method="post">
        <p>
            <label for="submitted-name">Name:</label>
            <input id="submitted-name" name="submitted-name" autocomplete="name">
        </p>

        <p>
            <label for="submitted-email">Email:</label>
            <input id="submitted-email" name="submitted-email" type="email" autocomplete="email">
        </p>

        <p>
            <label for="submitted-message">Message:</label><br>
            <textarea id="submitted-message" name="submitted-message" rows="5" cols="40"></textarea>
        </p>

        <p>By submitting this form, you understand that your name, email, and message may be shared with the website owner.</p>

        <fieldset>
            <legend>Do you agree to the terms?</legend>
            <label><input type="radio" name="terms" value="yes"> Yes</label><br>
            <label><input type="radio" name="terms" value="no"> No</label>
        </fieldset>

        <p><button type="submit">Save</button></p>
    </form>
</section>

<hr>

<section>
    <button type="button">Special Message For You &star;</button>
    <dialog open>
        <p>Thank you for visiting my resume website!</p>
        <button type="button">Close</button>
    </dialog>
</section>
