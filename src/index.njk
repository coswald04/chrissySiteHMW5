<article>
    <h2>Explore My Website</h2>
    <nav aria-label="Explore portfolio pages">
        {% for item in site.navigation %}
            {% if item.url != "/" %}
                <a href="{{ item.url }}">{{ item.label }}</a>
            {% endif %}
        {% endfor %}
    </nav>
</article>

<section>
    <h2>Dog of the Day</h2>

    <template id="dog-template">
        <article>
            <p data-status aria-live="polite">Waiting to load dog pictures.</p>

            <section data-results hidden>
                <h3 data-heading>Today's Dogs</h3>
                <ul data-dog-list></ul>
            </section>

            <button type="button" data-retry hidden>Try Again</button>

            <p>
                Images provided by
                <a href="https://dog.ceo/dog-api/">Dog CEO API</a>.
            </p>
        </article>
    </template>

    <dog-of-the-day breed="random" count="1">
        <p>Dog pictures require JavaScript and an internet connection.</p>
    </dog-of-the-day>
</section>
